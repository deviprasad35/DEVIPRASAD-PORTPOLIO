# API Configuration
# Copy this file to .env and fill in your values.

# Set to "false" to use the real backend (backend phase).
# Default is "true" — the contact form is in mock mode and does NOT send emails.
VITE_USE_MOCK_API=true

# Base URL of the backend API (used only when VITE_USE_MOCK_API=false)
VITE_API_URL=http://localhost:5000

# Formspree endpoint for the Contact form
# Create a free form at https://formspree.io, then paste the endpoint URL here.
# Example: https://formspree.io/f/abcdefgh
VITE_FORM_ENDPOINT=
